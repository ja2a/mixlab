{
  "name": "mixlab",
  "productName": "MixLab",
  "version": "0.1.1",
  "description": "Création automatique de mixtapes à partir de fichiers audio locaux",
  "main": "dist/main/main.js",
  "author": "ja2a",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/build-main.mjs && concurrently -k \"vite\" \"node scripts/build-main.mjs --watch\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-main.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:e2e": "npm run build && tsx scripts/gen-fixtures.ts && playwright test",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "app.mixlab.desktop",
    "productName": "MixLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "bin",
        "filter": [
          "ffmpeg*",
          "ffprobe*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ja2a",
        "repo": "mixlab",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ja2a/mixlab.git"
  }
}
